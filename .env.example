# Copy to .env at the project root. Never put API keys in frontend files.
LLM_MODE=mock
# For real model calls, set LLM_MODE=gemini and supply your own Google AI Studio key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional absolute paths; defaults are project-root/sample_repo and project-root/data.
# REPO_ROOT=C:/path/to/small/python/repository
# DATA_DIR=C:/path/to/local/data
